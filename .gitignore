# --- cache & HTML pihak ketiga (hak cipta + jejak scraping) ---------------
.cache_sinta/
debug/
tests/fixtures/*.html

# --- konfigurasi lokal -----------------------------------------------------
autorun_config.ini
!autorun_config.ini.example
cookies.txt
.netscape-cookies

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
